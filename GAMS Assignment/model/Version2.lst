  29   
  30  Set
  31      a  appliances    /fridge, dishwasher, washer, HVAC, ev/;
  32   
  33  * Power usage of appliances [kWh per hour]
  34  Parameter
  35      power(a) /
  36          fridge     0.8,
  37          dishwasher 1.8,
  38          washer     1.0,
  39          HVAC       2.0,
  40          ev         7.2
  41      /;
  42   
  43  * Required runtime per appliance during the day [hours]
  44  Parameter
  45      runtime(a) /
  46          fridge     24,
  47          dishwasher 2,
  48          washer     1,
  49          HVAC       3,
  50          ev         4
  51      /;
  52   
  53  * Time window matrix (1 if appliance 'a' is allowed to run in time 't')
  54  Parameter timewindow(a,t);
  55   
  56  * Default all to 0
  57  timewindow(a,t) = 0;
  58   
  59  * Appliance time windows using $ conditional
  60  timewindow("fridge",t)     = 1;
  61  timewindow("dishwasher",t)$(ord(t) >= 8 and ord(t) <= 22) = 1;
  62  timewindow("washer",t)    $(ord(t) >= 7 and ord(t) <= 21) = 1;
  63  timewindow("HVAC",t)    $(ord(t) >= 6 and ord(t) <= 23) = 1;
  64  timewindow("ev",t)        $(ord(t) <= 7 or ord(t) >= 22) = 1;
  65   
  66  * Binary decision variable: x(a,t) = 1 if appliance a runs at time t
  67  Binary Variable x(a,t);
  68   
  69  * Objective variable: total electricity cost
  70  Variable totalCost;
  71   
  72  Equation
  73      obj                   "Objective function"
  74      applianceRuntime(a)   "Ensure each appliance runs for required hours"
  75      timeWindowLimit(a,t)  "Only allow appliances to run within allowed time slots";
  76   
  77  * Objective function: Minimize total cost
  78  obj..
  79      totalCost =e= sum((a,t), x(a,t) * power(a) * price(t));
  80   
  81  * Each appliance must run for exactly its required runtime
  82  applianceRuntime(a)..
  83      sum(t, x(a,t)) =e= runtime(a);
  84   
  85  * Respect allowed time windows
  86  timeWindowLimit(a,t)..
  87      x(a,t) =l= timewindow(a,t);
  88   
  89  Model HomeEnergy /all/;
  90   
  91  Solve HomeEnergy using mip minimizing totalCost;
  92   
  93  * Display results
  94  Display x.l, totalCost.l;
